{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist/types",
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": ["hotkey-router.js", "auto.js", "reservations.js"],
  "exclude": ["*.test.js", "dist", "node_modules", "scripts", "playground"]
}
