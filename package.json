{
  "name": "hotkey-router",
  "version": "0.3.3",
  "description": "A tiny, deterministic keyboard routing engine for modern web apps.",
  "type": "module",
  "author": "WATT3D <WATT3D@protonmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "hotkeys",
    "keyboard",
    "shortcuts",
    "router",
    "javascript"
  ],
  "main": "./dist/hotkey-router.cjs",
  "module": "./dist/hotkey-router.js",
  "types": "./dist/types/hotkey-router.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/hotkey-router.d.ts",
      "import": "./dist/hotkey-router.js",
      "require": "./dist/hotkey-router.cjs"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./auto": {
      "types": "./dist/types/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./reservations": {
      "types": "./dist/types/reservations.d.ts",
      "import": "./dist/reservations.js"
    },
    "./sites": {
      "types": "./dist/types/sites.d.ts",
      "import": "./dist/sites.js"
    },
    "./validate": {
      "types": "./dist/types/validate.d.ts",
      "import": "./dist/validate.js"
    },
    "./format": {
      "types": "./dist/types/format.d.ts",
      "import": "./dist/format.js"
    },
    "./data/browser-hotkeys.json": "./data/browser-hotkeys.json",
    "./data/site-hotkeys.json": "./data/site-hotkeys.json",
    "./data/site-hotkeys.runtime.json": "./data/site-hotkeys.runtime.json"
  },
  "sideEffects": [
    "./dist/hotkey-router.js",
    "./dist/hotkey-router.cjs",
    "./dist/hotkey-router.min.js",
    "./dist/auto.js",
    "./dist/auto.min.js"
  ],
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "ADDITIONAL_TERMS.md",
    "robots.txt"
  ],
  "scripts": {
    "build": "node build.js",
    "build:types": "tsc -p tsconfig.types.json",
    "prepare": "node build.js && npm run build:types",
    "prepublishOnly": "npm test",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "test:browser": "node build.js && node --test browser-tests/*.browser.mjs",
    "scrape:diff": "node scripts/scrape-reservations.mjs",
    "scrape:apply": "node scripts/scrape-reservations.mjs --apply",
    "sites:build": "node scripts/build-site-hotkeys.cjs",
    "key-check": "node scripts/key-check-server.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^24.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iWhatty/hotkey-router.git"
  },
  "bugs": {
    "url": "https://github.com/iWhatty/hotkey-router/issues"
  },
  "homepage": "https://github.com/iWhatty/hotkey-router#readme"
}
